---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite, getPage } from '../lib/content';

const site = await getSite();
const impressum = await getPage('impressum');
---

<BaseLayout
  title={`Impressum – ${site.name}`}
  description={`Impressum der ${site.name}, ${site.address.street}, ${site.address.zip} ${site.address.city}`}
>
  <Header />
  <main id="main-content">
    <div data-cms-section="impressum" class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 data-cms-field="impressum.title" class="font-headline text-4xl font-extrabold tracking-tight text-ink">{impressum.title}</h1>

      <section class="mt-10">
        <h2 data-cms-field="impressum.companyHeading" class="font-headline text-xl font-bold text-ink">{impressum.companyHeading}</h2>
        <p class="mt-3 leading-relaxed text-ink-muted">
          <span data-cms-field="site.name">{site.name}</span><br />
          <span data-cms-field="site.address.street">{site.address.street}</span><br />
          <span data-cms-field="site.address.zip">{site.address.zip}</span> <span data-cms-field="site.address.city">{site.address.city}</span>
        </p>
      </section>

      <section class="mt-8">
        <h2 data-cms-field="impressum.ownerHeading" class="font-headline text-xl font-bold text-ink">{impressum.ownerHeading}</h2>
        <p class="mt-3 leading-relaxed text-ink-muted">
          <span data-cms-field="site.owner">{site.owner}</span> (<span data-cms-field="site.ownerTitle">{site.ownerTitle}</span>)
        </p>
      </section>

      <section class="mt-8">
        <h2 data-cms-field="impressum.contactHeading" class="font-headline text-xl font-bold text-ink">{impressum.contactHeading}</h2>
        <p class="mt-3 leading-relaxed text-ink-muted">
          <span data-cms-field="impressum.phoneLabel">{impressum.phoneLabel}</span> <a href={`tel:${site.phoneHref}`} class="text-primary underline"><span data-cms-field="site.phone">{site.phone}</span></a><br />
          <span data-cms-field="impressum.emailLabel">{impressum.emailLabel}</span> <a href={`mailto:${site.email}`} class="text-primary underline"><span data-cms-field="site.email">{site.email}</span></a>
        </p>
      </section>

      <section class="mt-8">
        <h2 data-cms-field="impressum.hoursHeading" class="font-headline text-xl font-bold text-ink">{impressum.hoursHeading}</h2>
        <p class="mt-3 leading-relaxed text-ink-muted">
          <span data-cms-field="site.hours.monThu">{site.hours.monThu}</span><br />
          <span data-cms-field="site.hours.fri">{site.hours.fri}</span>
        </p>
      </section>

      <section class="mt-8">
        <h2 data-cms-field="impressum.dispute.heading" class="font-headline text-xl font-bold text-ink">{impressum.dispute.heading}</h2>
        <p data-cms-field="impressum.dispute.text" class="mt-3 leading-relaxed text-ink-muted">
          {impressum.dispute.text.replace('{name}', site.name)}
        </p>
      </section>

      <section class="mt-8">
        <h2 data-cms-field="impressum.liability.heading" class="font-headline text-xl font-bold text-ink">{impressum.liability.heading}</h2>
        <p data-cms-field="impressum.liability.text" class="mt-3 leading-relaxed text-ink-muted">
          {impressum.liability.text}
        </p>
      </section>

      <section class="mt-8">
        <h2 data-cms-field="impressum.copyright.heading" class="font-headline text-xl font-bold text-ink">{impressum.copyright.heading}</h2>
        <p data-cms-field="impressum.copyright.text" class="mt-3 leading-relaxed text-ink-muted">
          {impressum.copyright.text}
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
