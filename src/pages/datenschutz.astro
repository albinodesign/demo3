---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite, getPage } from '../lib/content';

const site = await getSite();
const datenschutz = await getPage('datenschutz');
---

<BaseLayout
  title={`Datenschutzerklärung – ${site.name}`}
  description={`Datenschutzerklärung der ${site.name} gemäß DSGVO.`}
>
  <Header />
  <main id="main-content">
    <div data-cms-section="datenschutz" class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 data-cms-field="datenschutz.title" class="font-headline text-4xl font-extrabold tracking-tight text-ink">{datenschutz.title}</h1>

      <section class="mt-10">
        <h2 data-cms-field="datenschutz.controllerHeading" class="font-headline text-xl font-bold text-ink">{datenschutz.controllerHeading}</h2>
        <p data-cms-field="datenschutz.controllerIntro" class="mt-3 leading-relaxed text-ink-muted">
          {datenschutz.controllerIntro}
        </p>
        <p class="mt-3 leading-relaxed text-ink-muted">
          {site.name}<br />
          Inhaber: {site.owner} ({site.ownerTitle})<br />
          {site.address.street}<br />
          {site.address.zip} {site.address.city}<br />
          Telefon: <a data-cms-field="site.phone" href={`tel:${site.phoneHref}`} class="text-primary underline">{site.phone}</a><br />
          E-Mail: <a data-cms-field="site.email" href={`mailto:${site.email}`} class="text-primary underline">{site.email}</a>
        </p>
      </section>

      {datenschutz.sections.map((section, i) => (
        <section class="mt-8">
          <h2 data-cms-field={`datenschutz.sections.${i}.heading`} class="font-headline text-xl font-bold text-ink">{section.heading}</h2>
          <p data-cms-field={`datenschutz.sections.${i}.text`} class="mt-3 leading-relaxed text-ink-muted">
            {section.text}
          </p>
        </section>
      ))}

      <p class="mt-10 text-sm text-ink-muted">
        <span data-cms-field="datenschutz.closing">{datenschutz.closing}</span>
        <a data-cms-field="site.email" href={`mailto:${site.email}`} class="text-primary underline">{site.email}</a>.
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>
