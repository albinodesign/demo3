---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneIcon from '../components/icons/Phone.astro';
import EnvelopeIcon from '../components/icons/Envelope.astro';
import MapPinIcon from '../components/icons/MapPin.astro';
import ClockIcon from '../components/icons/Clock.astro';
import { getSite, getPage } from '../lib/content';

const site = await getSite();
const home = await getPage('home');
const kontakt = await getPage('kontakt');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Kontakt & Angebot – ${site.name}`,
  url: `${Astro.site?.toString()}kontakt`,
  about: {
    '@type': 'HomeAndConstructionBusiness',
    name: site.name,
    telephone: site.phone,
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.zip,
      addressLocality: site.address.city,
      addressCountry: 'DE',
    },
  },
};
---

<BaseLayout
  title={`Kontakt & Angebot – ${site.name}`}
  description={`Kontaktieren Sie ${site.name} in ${site.address.city}: Telefon ${site.phone} oder über das Kontaktformular. Kostenloses Festpreis-Angebot.`}
>
  <Header />
  <main id="main-content">
    <section data-cms-section="kontakt" class="bg-surface">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-5 lg:py-24 lg:px-8">
        <div data-cms-section="kontakt.intro" class="lg:col-span-2">
          <h1 data-cms-field="kontakt.intro.title" class="font-headline text-4xl font-extrabold tracking-tight text-ink">
            {kontakt.intro.title}
          </h1>
          <p data-cms-field="kontakt.intro.subtitle" class="mt-4 text-lg text-ink-muted">
            {kontakt.intro.subtitle}
          </p>

          <ul class="mt-10 space-y-5">
            <li>
              <a href={`tel:${site.phoneHref}`} class="flex items-center gap-4 rounded-xl bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary text-white">
                  <PhoneIcon class="h-5 w-5" />
                </span>
                <span>
                  <span data-cms-field="kontakt.contactLabels.phone" class="block text-xs font-medium uppercase tracking-wide text-ink-muted">{kontakt.contactLabels.phone}</span>
                  <span data-cms-field="site.phone" class="font-semibold text-ink">{site.phone}</span>
                </span>
              </a>
            </li>
            <li>
              <a href={`mailto:${site.email}`} class="flex items-center gap-4 rounded-xl bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary text-white">
                  <EnvelopeIcon class="h-5 w-5" />
                </span>
                <span>
                  <span data-cms-field="kontakt.contactLabels.email" class="block text-xs font-medium uppercase tracking-wide text-ink-muted">{kontakt.contactLabels.email}</span>
                  <span data-cms-field="site.email" class="font-semibold text-ink">{site.email}</span>
                </span>
              </a>
            </li>
            <li class="flex items-center gap-4 rounded-xl bg-white p-4 shadow-sm">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary text-white">
                <MapPinIcon class="h-5 w-5" />
              </span>
              <span>
                <span data-cms-field="kontakt.contactLabels.address" class="block text-xs font-medium uppercase tracking-wide text-ink-muted">{kontakt.contactLabels.address}</span>
                <span class="font-semibold text-ink">{site.address.street}, {site.address.zip} {site.address.city}</span>
              </span>
            </li>
            <li class="flex items-center gap-4 rounded-xl bg-white p-4 shadow-sm">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary text-white">
                <ClockIcon class="h-5 w-5" />
              </span>
              <span>
                <span data-cms-field="kontakt.contactLabels.hours" class="block text-xs font-medium uppercase tracking-wide text-ink-muted">{kontakt.contactLabels.hours}</span>
                <span class="font-semibold text-ink"><span data-cms-field="site.hours.monThu">{site.hours.monThu}</span> &middot; <span data-cms-field="site.hours.fri">{site.hours.fri}</span></span>
              </span>
            </li>
          </ul>
        </div>

        <div data-cms-section="kontakt.form" class="lg:col-span-3">
          <form
            id="contact-form"
            class="rounded-2xl bg-white p-6 shadow-sm sm:p-8"
            data-web3forms-key={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''}
            data-messages={JSON.stringify({ ...kontakt.messages, submitSending: kontakt.form.submitSending, submitLabel: kontakt.form.submitLabel })}
            novalidate
          >
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-sm font-semibold text-ink">
                  <span data-cms-field="kontakt.form.labelName">{kontakt.form.labelName}</span> <span class="text-accent-dark" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  class="mt-1.5 block w-full rounded-lg border border-gray-300 px-4 py-3 text-ink focus:border-primary focus:outline-2 focus:outline-primary/30"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-ink">
                  <span data-cms-field="kontakt.form.labelEmail">{kontakt.form.labelEmail}</span> <span class="text-accent-dark" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="mt-1.5 block w-full rounded-lg border border-gray-300 px-4 py-3 text-ink focus:border-primary focus:outline-2 focus:outline-primary/30"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold text-ink" data-cms-field="kontakt.form.labelPhone">{kontakt.form.labelPhone}</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  class="mt-1.5 block w-full rounded-lg border border-gray-300 px-4 py-3 text-ink focus:border-primary focus:outline-2 focus:outline-primary/30"
                />
              </div>
              <div>
                <label for="topic" class="block text-sm font-semibold text-ink" data-cms-field="kontakt.form.labelTopic">{kontakt.form.labelTopic}</label>
                <select
                  id="topic"
                  name="topic"
                  class="mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-ink focus:border-primary focus:outline-2 focus:outline-primary/30"
                >
                  {home.services.items.map((s) => <option value={s.title}>{s.title}</option>)}
                  <option value={kontakt.form.optionOther} data-cms-field="kontakt.form.optionOther">{kontakt.form.optionOther}</option>
                </select>
              </div>
            </div>

            <div class="mt-5">
              <label for="message" class="block text-sm font-semibold text-ink">
                <span data-cms-field="kontakt.form.labelMessage">{kontakt.form.labelMessage}</span> <span class="text-accent-dark" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="mt-1.5 block w-full rounded-lg border border-gray-300 px-4 py-3 text-ink focus:border-primary focus:outline-2 focus:outline-primary/30"
              ></textarea>
            </div>

            <!-- Honeypot: für Menschen unsichtbar, Bots füllen ihn aus -->
            <div class="hidden" aria-hidden="true">
              <label for="company">Firma</label>
              <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
            </div>

            <div class="mt-5">
              <label class="flex cursor-pointer items-start gap-3">
                <input
                  type="checkbox"
                  id="privacy"
                  name="privacy"
                  required
                  class="mt-1 h-5 w-5 shrink-0 rounded border-gray-300 text-primary accent-primary"
                />
                <span class="text-sm text-ink-muted">
                  <span data-cms-field="kontakt.form.privacyTextPre">{kontakt.form.privacyTextPre}</span> <a href="/datenschutz" class="font-medium text-primary underline">Datenschutzerklärung</a> <span data-cms-field="kontakt.form.privacyTextPost">{kontakt.form.privacyTextPost}</span> <span class="text-accent-dark" aria-hidden="true">*</span>
                </span>
              </label>
            </div>

            <p id="form-status" class="mt-4 hidden rounded-lg px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></p>

            <button
              type="submit"
              class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-accent px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:w-auto"
            >
              <span data-cms-field="kontakt.form.submitLabel">{kontakt.form.submitLabel}</span>
            </button>
            <p class="mt-3 text-xs text-ink-muted">
              <span data-cms-field="kontakt.form.requiredNotePre">{kontakt.form.requiredNotePre}</span> <span class="text-accent-dark" aria-hidden="true">*</span> <span data-cms-field="kontakt.form.requiredNotePost">{kontakt.form.requiredNotePost}</span>
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  const messages = JSON.parse(form?.dataset.messages ?? '{}') as {
    name: string;
    email: string;
    message: string;
    privacy: string;
    honeypotSuccess: string;
    success: string;
    notConfigured: string;
    error: string;
    offline: string;
    submitSending: string;
    submitLabel: string;
  };

  function setStatus(kind: 'success' | 'error', text: string) {
    if (!status) return;
    status.classList.remove('hidden', 'bg-trust/10', 'text-trust', 'bg-red-50', 'text-red-800');
    status.classList.add(...(kind === 'success' ? ['bg-trust/10', 'text-trust'] : ['bg-red-50', 'text-red-800']));
    status.textContent = text;
  }

  function markInvalid(field: HTMLElement, invalid: boolean) {
    field.setAttribute('aria-invalid', String(invalid));
    field.classList.toggle('border-red-500', invalid);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    // Honeypot: ausgefüllt = Bot → stillschweigend „Erfolg" melden
    const honeypot = form.elements.namedItem('company') as HTMLInputElement | null;
    if (honeypot?.value) {
      setStatus('success', messages.honeypotSuccess ?? '');
      form.reset();
      return;
    }

    // Clientseitige Validierung
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const message = form.elements.namedItem('message') as HTMLTextAreaElement;
    const privacy = form.elements.namedItem('privacy') as HTMLInputElement;

    const errors: string[] = [];
    const checks: Array<[HTMLElement, boolean, string]> = [
      [name, name.value.trim().length < 2, messages.name],
      [email, !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim()), messages.email],
      [message, message.value.trim().length < 10, messages.message],
      [privacy, !privacy.checked, messages.privacy],
    ];
    for (const [field, invalid, msg] of checks) {
      markInvalid(field, invalid);
      if (invalid) errors.push(msg);
    }
    if (errors.length > 0) {
      setStatus('error', errors.join(' '));
      return;
    }

    const key = form.dataset.web3formsKey ?? '';
    if (!key) {
      setStatus('error', messages.notConfigured ?? '');
      return;
    }

    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;
    button.textContent = messages.submitSending ?? '';

    try {
      const data = Object.fromEntries(new FormData(form).entries());
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject: `Anfrage über klarwerk-fenster.de: ${data.topic ?? 'Allgemein'}`,
          name: data.name,
          email: data.email,
          phone: data.phone || '–',
          topic: data.topic,
          message: data.message,
        }),
      });
      const result = (await response.json()) as { success?: boolean };
      if (response.ok && result.success) {
        setStatus('success', messages.success ?? '');
        form.reset();
      } else {
        setStatus('error', messages.error ?? '');
      }
    } catch {
      setStatus('error', messages.offline ?? '');
    } finally {
      button.disabled = false;
      button.textContent = messages.submitLabel ?? '';
    }
  });
</script>
