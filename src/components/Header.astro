---
import { getSite } from '../lib/content';
import WindowIcon from './icons/Window.astro';
import PhoneIcon from './icons/Phone.astro';
import BarsIcon from './icons/Bars.astro';
import XMarkIcon from './icons/XMark.astro';

const site = await getSite();

const navItems = [
  { label: 'Leistungen', href: '/#leistungen' },
  { label: 'Warum Klarwerk', href: '/#warum' },
  { label: 'Bewertungen', href: '/#bewertungen' },
  { label: 'Kontakt', href: '/kontakt' },
];
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} – Startseite`}>
      <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white">
        <WindowIcon class="h-5 w-5" />
      </span>
      <span class="font-headline text-lg font-extrabold tracking-tight text-ink">
        Klarwerk <span class="hidden text-sm font-medium text-ink-muted sm:inline">Fenster &amp; Türen</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm font-medium text-ink-muted transition-colors hover:text-primary">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phoneHref}`}
        class="hidden items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark sm:flex"
      >
        <PhoneIcon class="h-4 w-4" />
        {site.phone}
      </a>
      <button
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center rounded-lg text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menü öffnen"
      >
        <BarsIcon class="h-6 w-6" data-icon="open" />
        <XMarkIcon class="hidden h-6 w-6" data-icon="close" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-gray-100 bg-white lg:hidden">
    <nav class="space-y-1 px-4 py-4" aria-label="Mobile Navigation">
      {navItems.map((item) => (
        <a href={item.href} class="block rounded-lg px-3 py-3 text-base font-medium text-ink hover:bg-surface">
          {item.label}
        </a>
      ))}
      <a
        href={`tel:${site.phoneHref}`}
        class="mt-2 flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-base font-semibold text-white"
      >
        <PhoneIcon class="h-4 w-4" />
        {site.phone}
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    toggle.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
  });
</script>
