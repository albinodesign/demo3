---
import type { getPage } from '../../lib/content';

interface Props {
  trust: Awaited<ReturnType<typeof getPage>>['trust'];
}

const { trust } = Astro.props;
---

<section data-cms-section="home.trust" class="border-y border-gray-100 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <dl class="grid grid-cols-2 gap-8 text-center lg:grid-cols-4">
      {trust.items.map((item) => (
        <div class="flex flex-col-reverse">
          <dt class="mt-1 text-sm font-medium text-ink-muted">{item.label}</dt>
          <dd class="font-headline text-3xl font-extrabold text-primary sm:text-4xl">
            {item.value}
            {item.suffix && <span class="ml-1 text-xl font-bold text-accent sm:text-2xl">{item.suffix}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
